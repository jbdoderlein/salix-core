    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "request": "attach",
            "name": "Attach by Process ID",
            "processId": "${command:PickJavaProcess}"
        },
        {
            "type": "rascalmpl",
            "name": "Rascal debugger",
            "request": "attach"
        },
        {
            "type": "java",
            "name": "Launch Custom Rascal Shell",
            "request": "launch",
            "mainClass": "org.rascalmpl.shell.RascalShell",
            "classPaths": [
                "/home/jbdod/CWI/rascal/target/rascal-0.41.0-RC74-SNAPSHOT.jar",
            ],
            "vmArgs": "-Xmx4800M",
            "console": "integratedTerminal",

        }
    ]
}